        "binding": {
          "type": "camunda:property",
          "name": "cardJson"
        }
      },
      {
        "label": "Response Result Variable Name",
        "type": "String",
        "group": "responseMapping",
        "binding": {
          "type": "camunda:property",
          "name": "resultVariable"
        }
      }
    ]
  },
  {
    "$schema": "https://unpkg.com/@camunda/element-templates-json-schema/resources/schema.json",
    "name": "SendGrid Email Connector",
    "id": "io.camunda.connectors.SendGrid.v1",
    "description": "Send transactional emails via SendGrid v3 Mail Send API using text, HTML, or Dynamic Templates",
    "documentationRef": "https://docs.camunda.io/docs/components/connectors/outbound/sendgrid/",
    "category": {
      "id": "connectors",
      "name": "Camunda Connectors"
    },
    "appliesTo": [
      "bpmn:Task",
      "bpmn:ServiceTask"
    ],
    "groups": [
      {
        "id": "authentication",
        "label": "API Key & Auth"
      },
      {
        "id": "sender",
        "label": "Sender Information"
      },
      {
        "id": "recipient",
        "label": "Recipient Information"
      },
      {
        "id": "content",
        "label": "Email Content & Templates"
      },
      {
        "id": "responseMapping",
        "label": "Response Mapping"
      }
    ],
    "properties": [
      {
        "label": "SendGrid API Key (Bearer Token)",
        "type": "String",
        "group": "authentication",
        "binding": {
          "type": "camunda:property",
          "name": "apiKey"
        },
        "constraints": {
          "notEmpty": true
        }
      },
      {
        "label": "From Sender Email",
        "type": "String",
        "group": "sender",
        "binding": {
          "type": "camunda:property",
          "name": "fromEmail"
        },
        "constraints": {
          "notEmpty": true
        }
      },
      {
        "label": "From Sender Name",
        "type": "String",
        "group": "sender",
        "binding": {
          "type": "camunda:property",
          "name": "fromName"
        }
      },
      {
        "label": "Recipient To Email",
        "type": "String",
        "group": "recipient",
        "binding": {
          "type": "camunda:property",
          "name": "toEmail"
        },
        "constraints": {
          "notEmpty": true
        }
      },
      {
        "label": "Recipient To Name",
        "type": "String",
        "group": "recipient",
        "binding": {
          "type": "camunda:property",
          "name": "toName"
        }
      },
      {
        "label": "CC Email Addresses (comma separated)",
        "type": "String",
        "group": "recipient",
        "binding": {
          "type": "camunda:property",
          "name": "ccEmails"
        }
      },
      {
        "label": "BCC Email Addresses (comma separated)",
        "type": "String",
        "group": "recipient",
        "binding": {
          "type": "camunda:property",
          "name": "bccEmails"
        }
      },
      {
        "label": "Email Subject",
        "type": "String",
        "group": "content",
        "binding": {
          "type": "camunda:property",
          "name": "subject"
        },
        "constraints": {
          "notEmpty": true
        }
      },
      {
        "label": "Content Type",
        "type": "Dropdown",
        "value": "text/plain",
        "group": "content",
        "choices": [
          {
            "name": "Plain Text (text/plain)",
            "value": "text/plain"
          },
          {
            "name": "HTML (text/html)",
            "value": "text/html"
          },
          {
            "name": "Dynamic Template",
            "value": "template"
          }
        ],
        "binding": {
          "type": "camunda:property",
          "name": "contentType"
        }
      },
      {
        "label": "Email Body (Text or HTML)",
        "type": "String",
        "multiline": true,
        "group": "content",
        "binding": {
          "type": "camunda:property",
          "name": "contentValue"
        }
      },
      {
        "label": "Dynamic Template ID (d-xxx)",
        "type": "String",
        "group": "content",
        "binding": {
          "type": "camunda:property",
          "name": "templateId"
        }
      },
      {
        "label": "Dynamic Template Data (JSON)",
        "type": "String",
        "multiline": true,
        "group": "content",
        "binding": {
          "type": "camunda:property",
          "name": "templateData"
        }
      },
      {
        "label": "Response Result Variable Name",
        "type": "String",
        "group": "responseMapping",
        "binding": {
          "type": "camunda:property",
          "name": "resultVariable"
        }
      }
    ]
  },
