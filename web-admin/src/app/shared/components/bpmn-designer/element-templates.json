      },
      {
        "label": "Custom Headers (JSON)",
        "type": "String",
        "multiline": true,
        "group": "headers",
        "binding": {
          "type": "camunda:property",
          "name": "headers"
        }
      },
      {
        "label": "Response Result Variable Name",
        "type": "String",
        "group": "responseMapping",
        "binding": {
          "type": "camunda:property",
          "name": "resultVariable"
        }
      },
      {
        "label": "Response Expression",
        "type": "String",
        "group": "responseMapping",
        "binding": {
          "type": "camunda:property",
          "name": "resultExpression"
        }
      }
    ]
  },
  {
    "$schema": "https://unpkg.com/@camunda/element-templates-json-schema/resources/schema.json",
    "name": "Slack Outbound Connector",
    "id": "io.camunda.connectors.Slack.v1",
    "description": "Send Slack messages to public/private channels or direct users using Webhooks or Bot Token API",
    "documentationRef": "https://docs.camunda.io/docs/components/connectors/outbound/slack/",
    "category": {
      "id": "connectors",
      "name": "Camunda Connectors"
    },
    "appliesTo": [
      "bpmn:Task",
      "bpmn:ServiceTask"
    ],
    "groups": [
      {
        "id": "authentication",
        "label": "Authentication & Connection"
      },
      {
        "id": "request",
        "label": "Slack Message Details"
      },
      {
        "id": "responseMapping",
        "label": "Response Mapping"
      }
    ],
    "properties": [
      {
        "label": "Authentication Method",
        "type": "Dropdown",
        "value": "token",
        "group": "authentication",
        "choices": [
          {
            "name": "Bot Token (xoxb-...)",
            "value": "token"
          },
          {
            "name": "Incoming Webhook URL",
            "value": "webhook"
          }
        ],
        "binding": {
          "type": "camunda:property",
          "name": "authentication.method"
        }
      },
      {
        "label": "Slack OAuth Bot Token (xoxb-...)",
        "type": "String",
        "group": "authentication",
        "binding": {
          "type": "camunda:property",
          "name": "authentication.token"
        }
      },
      {
        "label": "Incoming Webhook URL",
        "type": "String",
        "group": "authentication",
        "binding": {
          "type": "camunda:property",
          "name": "authentication.webhookUrl"
        }
      },
      {
        "label": "Action",
        "type": "Dropdown",
        "value": "chat.postMessage",
        "group": "request",
        "choices": [
          {
            "name": "Post Message (chat.postMessage)",
            "value": "chat.postMessage"
          },
          {
            "name": "Update Message (chat.update)",
            "value": "chat.update"
          },
          {
            "name": "Create Channel (channels.create)",
            "value": "channels.create"
          },
          {
            "name": "Lookup User by Email (users.lookupByEmail)",
            "value": "users.lookupByEmail"
          }
        ],
        "binding": {
          "type": "camunda:property",
          "name": "action"
        }
      },
      {
        "label": "Target Channel Name / ID or User ID",
        "type": "String",
        "group": "request",
        "binding": {
          "type": "camunda:property",
          "name": "channel"
        }
      },
      {
        "label": "Message Text",
        "type": "String",
        "multiline": true,
        "group": "request",
        "binding": {
          "type": "camunda:property",
          "name": "text"
        }
      },
      {
        "label": "Slack Block Kit JSON Payload",
        "type": "String",
        "multiline": true,
        "group": "request",
        "binding": {
          "type": "camunda:property",
          "name": "blocks"
        }
      },
      {
        "label": "Thread Timestamp (for replies)",
        "type": "String",
        "group": "request",
        "binding": {
          "type": "camunda:property",
          "name": "threadTs"
        }
      },
      {
        "label": "User Email (for Lookup User action)",
        "type": "String",
        "group": "request",
        "binding": {
          "type": "camunda:property",
          "name": "userEmail"
        }
      },
      {
        "label": "Response Result Variable Name",
        "type": "String",
        "group": "responseMapping",
        "binding": {
          "type": "camunda:property",
          "name": "resultVariable"
        }
      }
    ]
  },
  {
    "$schema": "https://unpkg.com/@camunda/element-templates-json-schema/resources/schema.json",
