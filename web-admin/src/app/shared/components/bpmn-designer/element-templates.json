    "category": {
      "id": "connectors",
      "name": "Camunda Connectors"
    },
    "appliesTo": [
      "bpmn:Task",
      "bpmn:ServiceTask"
    ],
    "groups": [
      {
        "id": "authentication",
        "label": "OpenAI API Auth"
      },
      {
        "id": "modelConfig",
        "label": "Model & Parameters"
