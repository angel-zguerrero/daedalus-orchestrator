[
  {
    "$schema": "https://unpkg.com/@camunda/element-templates-json-schema/resources/schema.json",
    "name": "HTTP REST Connector",
    "id": "io.camunda.connectors.HttpJson.v1",
    "description": "Execute HTTP GET, POST, PUT, PATCH, DELETE requests to external REST endpoints",
    "documentationRef": "https://docs.camunda.io/docs/components/connectors/outbound/http-rest/",
    "category": {
      "id": "connectors",
      "name": "Camunda Connectors"
    },
    "appliesTo": [
      "bpmn:Task",
      "bpmn:ServiceTask"
    ],
    "properties": [
      {
        "label": "Authentication Type",
        "type": "Dropdown",
        "value": "noAuth",
        "choices": [
          { "name": "No Authentication", "value": "noAuth" },
          { "name": "Basic Authentication", "value": "basic" },
          { "name": "Bearer Token", "value": "bearer" }
        ],
        "binding": {
          "type": "camunda:property",
          "name": "authenticationType"
        }
      },
      {
        "label": "HTTP Method",
        "type": "Dropdown",
        "value": "GET",
        "choices": [
          { "name": "GET", "value": "GET" },
          { "name": "POST", "value": "POST" },
          { "name": "PUT", "value": "PUT" },
          { "name": "PATCH", "value": "PATCH" },
          { "name": "DELETE", "value": "DELETE" }
        ],
        "binding": {
          "type": "camunda:property",
          "name": "method"
        },
        "constraints": {
          "notEmpty": true
        }
      },
      {
        "label": "Target URL Endpoint",
        "type": "String",
        "value": "https://api.example.com/v1/resource",
        "binding": {
          "type": "camunda:property",
          "name": "url"
        },
        "constraints": {
          "notEmpty": true
        }
      },
      {
        "label": "Request Body (JSON)",
        "type": "String",
        "multiline": true,
        "value": "{\n  \"key\": \"value\"\n}",
        "binding": {
          "type": "camunda:property",
          "name": "body"
        }
      },
      {
        "label": "Headers (JSON)",
        "type": "String",
        "multiline": true,
        "value": "{\n  \"Content-Type\": \"application/json\"\n}",
        "binding": {
          "type": "camunda:property",
          "name": "headers"
        }
      },
      {
        "label": "Connection Timeout (ms)",
        "type": "String",
        "value": "10000",
        "binding": {
          "type": "camunda:property",
          "name": "connectionTimeout"
        }
      }
    ]
  },
  {
    "$schema": "https://unpkg.com/@camunda/element-templates-json-schema/resources/schema.json",
    "name": "GraphQL Connector",
    "id": "io.camunda.connectors.GraphQL.v1",
    "description": "Execute GraphQL queries or mutations against a GraphQL endpoint",
    "documentationRef": "https://docs.camunda.io/docs/components/connectors/outbound/graphql/",
    "category": {
      "id": "connectors",
      "name": "Camunda Connectors"
    },
    "appliesTo": [
      "bpmn:Task",
      "bpmn:ServiceTask"
    ],
    "properties": [
      {
        "label": "GraphQL Endpoint URL",
        "type": "String",
        "value": "https://api.example.com/graphql",
        "binding": {
          "type": "camunda:property",
          "name": "url"
        },
        "constraints": {
          "notEmpty": true
        }
      },
      {
        "label": "Query Statement",
        "type": "String",
        "multiline": true,
        "value": "query GetUser($id: ID!) {\n  user(id: $id) {\n    id\n    name\n    email\n  }\n}",
        "binding": {
          "type": "camunda:property",
          "name": "query"
        },
        "constraints": {
          "notEmpty": true
        }
      },
      {
        "label": "Variables (JSON)",
        "type": "String",
        "multiline": true,
        "value": "{\n  \"id\": \"123\"\n}",
        "binding": {
          "type": "camunda:property",
          "name": "variables"
        }
      }
    ]
  },
  {
    "$schema": "https://unpkg.com/@camunda/element-templates-json-schema/resources/schema.json",
