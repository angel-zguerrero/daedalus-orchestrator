{
  "name": "@omicron-x/daedalus-sdk",
  "version": "1.1.1",
  "description": "Daedalus Orchestrator Node.js Worker",
  "homepage": "https://github.com/angel-zguerrero/daedalus-orchestrator/tree/main/sdk/nodejs-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angel-zguerrero/daedalus-orchestrator.git",
    "directory": "sdk/nodejs-sdk"
  },
  "bugs": {
    "url": "https://github.com/angel-zguerrero/daedalus-orchestrator/issues"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "mkdir -p src/proto && grpc_tools_node_protoc --js_out=import_style=commonjs,binary:./src/proto --grpc_out=grpc_js:./src/proto --plugin=protoc-gen-ts=./node_modules/.bin/protoc-gen-ts --ts_out=grpc_js:./src/proto -I ../../server/internal/infrastructure/server/grpc/proto/definitions ../../server/internal/infrastructure/server/grpc/proto/definitions/*.proto",
    "prepare": "npm run build",
    "build": "tsc",
    "example:simple-worker": "ts-node examples/simple-worker/index.ts",
    "example:assert-resources": "ts-node examples/assert-resources/index.ts",
    "example:email-simulator": "ts-node \"examples/email simulator/index.ts\""
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.9.0",
    "google-protobuf": "^3.21.4",
    "systeminformation": "^5.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "grpc-tools": "^1.13.1",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "daedalus",
    "workflow",
    "orchestration",
    "workflow-engine",
    "distributed",
    "worker",
    "task-queue",
    "grpc",
    "microservices",
    "durable-execution",
    "automation"
  ]
}
